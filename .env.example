APP_NAME=Whale MAS
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
POSTGRES_USER=whale
POSTGRES_PASSWORD=change-me
POSTGRES_DB=whale_mas
DATABASE_URL=postgresql+asyncpg://whale:change-me@postgres:5432/whale_mas
CHECKPOINT_DATABASE_URL=postgresql://whale:change-me@postgres:5432/whale_mas
LANGGRAPH_STRICT_MSGPACK=true
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=whale-mas
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.eml,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.jpg,.jpeg,.png
AUDIT_HASH_CHAIN_ENABLED=true

#=== 配置LLM ====#

LLM_ENABLED=false
LLM_BASE_URL=https://172.16.102.166:3000
LLM_API_KEY=
LLM_MODEL=qwen38-27B-fp8
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARACTERS=120000
LLM_FALLBACK_TO_RULES=true
